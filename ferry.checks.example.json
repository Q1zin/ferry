{
  "profiles": {
    "rust": {
      "platforms": {
        "macos": {
          "command": "cargo test --workspace > {output}/tests.log 2>&1",
          "shell": "bash",
          "tools": [
            "cargo"
          ]
        },
        "windows": {
          "command": "cargo test --workspace > {output}/tests.log 2>&1; exit $LASTEXITCODE",
          "shell": "powershell",
          "tools": [
            "cargo"
          ]
        }
      },
      "timeout": 600,
      "artifacts": [
        "tests.log"
      ],
      "headless": true
    },
    "pytest": {
      "platforms": {
        "all": {
          "command": "python3 -m pytest --junitxml={output}/junit.xml",
          "tools": [
            "python3"
          ]
        }
      },
      "timeout": 300,
      "junit": "junit.xml",
      "headless": true
    },
    "web": {
      "platforms": {
        "all": {
          "build": "bun run build",
          "launch": "bun run serve -- --port 9322 --run-token {run}",
          "command": "bun run test:e2e -- --report-dir {output}",
          "shell": "bash",
          "tools": [
            "bun"
          ]
        }
      },
      "headless": true,
      "timeout": 600,
      "ready_http": {
        "port": 9322,
        "path": "/ready",
        "status": 200,
        "contains": "{run}"
      },
      "junit": "junit.xml"
    }
  }
}
