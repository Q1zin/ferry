{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ferry",
  "identifier": "io.github.q1zin.ferry",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ferry",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 540,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxNkRDQzkwNTJCRDc5MUMKUldRY2ViMVNrTXh0UWNVczFvQklPT3pYTWdMQ1RmMU84QVpBYnk1eEMyRlBJTGs3TklYU1d5eTcK",
      "endpoints": [
        "https://github.com/Q1zin/ferry/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
